{
  "info": {
    "_postman_id": "4e2f5ac9-356d-4851-a469-77a7104a0f10",
    "name": "TaskFlow Local API",
    "description": "Postman v2.1 collection for the fixed TaskFlow API contract. Run only against the local disposable service. Writes are guarded to resources created by this collection; the collection-level script restricts baseUrl to loopback.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const rawBaseUrl = pm.variables.replaceIn('{{baseUrl}}');",
          "let parsedBaseUrl;",
          "try {",
          "  parsedBaseUrl = new URL(rawBaseUrl);",
          "} catch (error) {",
          "  console.error('TaskFlow collection requires a valid local baseUrl.');",
          "  pm.execution.skipRequest();",
          "}",
          "if (parsedBaseUrl) {",
          "  const host = parsedBaseUrl.hostname.toLowerCase().replace(/^\\[|\\]$/g, '');",
          "  const isLoopback = host === 'localhost' || host === '127.0.0.1' || host === '::1';",
          "if (parsedBaseUrl.protocol !== 'http:' || !isLoopback || parsedBaseUrl.pathname !== '/' || parsedBaseUrl.search || parsedBaseUrl.hash || parsedBaseUrl.username || parsedBaseUrl.password) {",
          "    console.error('TaskFlow collection is restricted to an http loopback baseUrl.');",
          "    pm.execution.skipRequest();",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Create task owned by this collection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"TaskFlow Postman sample\",\n  \"description\": \"Created by this collection run; safe to update and delete through its chained requests.\",\n  \"dueDate\": null,\n  \"priority\": \"medium\",\n  \"projectId\": null,\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of ['taskflowCreatedTaskId', 'taskflowOwnedTaskId', 'taskflowTaskVersion', 'taskflowTaskEtag', 'taskflowPreviousEtag']) {",
              "  pm.collectionVariables.set(key, '');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create returns 201 and capture only its task after validation', function () {",
              "  pm.response.to.have.status(201);",
              "  const task = pm.response.json();",
              "  pm.expect(task).to.have.property('id').that.is.a('string');",
              "  pm.expect(task).to.have.property('title', 'TaskFlow Postman sample');",
              "  pm.expect(task).to.have.property('description', 'Created by this collection run; safe to update and delete through its chained requests.');",
              "  pm.expect(task.version).to.be.a('number');",
              "  const etag = pm.response.headers.get('ETag');",
              "  const match = etag && etag.match(/^\\\"(0|[1-9][0-9]*)\\\"$/);",
              "  pm.expect(match, 'strong quoted decimal ETag').to.not.eql(null);",
              "  pm.expect(Number(match[1])).to.eql(task.version);",
              "  const baseUrl = new URL(pm.variables.replaceIn('{{baseUrl}}'));",
              "  const locationValue = pm.response.headers.get('Location');",
              "  pm.expect(locationValue, 'Location header').to.be.a('string');",
              "  const location = new URL(locationValue, baseUrl);",
              "  pm.expect(location.origin).to.eql(baseUrl.origin);",
              "  pm.expect(location.pathname).to.eql('/api/tasks/' + task.id);",
              "  pm.collectionVariables.set('taskflowCreatedTaskId', task.id);",
              "  pm.collectionVariables.set('taskflowOwnedTaskId', task.id);",
              "  pm.collectionVariables.set('taskflowTaskVersion', String(task.version));",
              "  pm.collectionVariables.set('taskflowTaskEtag', etag);",
              "  pm.collectionVariables.set('taskflowPreviousEtag', '');",
              "});"
            ]
          }
        }
      ]
    },
