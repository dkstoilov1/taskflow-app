    {
      "name": "Error: missing If-Match (428)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/problem+json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"This request must not be applied\",\n  \"description\": \"It intentionally omits If-Match.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks/{{taskflowCreatedTaskId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.collectionVariables.get('taskflowCreatedTaskId');",
              "const ownerId = pm.collectionVariables.get('taskflowOwnedTaskId');",
              "if (!id || ownerId !== id || pm.variables.replaceIn('{{taskflowCreatedTaskId}}') !== id) {",
              "  console.error('Run the collection create request first; missing-header test is limited to its task.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing If-Match returns Problem Details 428', function () {",
              "  pm.response.to.have.status(428);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json()).to.have.property('status', 428);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Error: stale If-Match (412)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/problem+json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "If-Match",
            "value": "{{taskflowPreviousEtag}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Stale update must not be applied\",\n  \"description\": \"This request uses the pre-update ETag.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks/{{taskflowCreatedTaskId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.collectionVariables.get('taskflowCreatedTaskId');",
              "const ownerId = pm.collectionVariables.get('taskflowOwnedTaskId');",
              "const oldEtag = pm.collectionVariables.get('taskflowPreviousEtag');",
              "const latestEtag = pm.collectionVariables.get('taskflowTaskEtag');",
              "if (!id || ownerId !== id || pm.variables.replaceIn('{{taskflowCreatedTaskId}}') !== id || !oldEtag || oldEtag === latestEtag || pm.variables.replaceIn('{{taskflowPreviousEtag}}') !== oldEtag) {",
              "  console.error('Run create and update first; stale-version test requires this task’s prior ETag.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Stale If-Match returns Problem Details 412', function () {",
              "  pm.response.to.have.status(412);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json()).to.have.property('status', 412);",
              "});"
            ]
          }
        }
      ]
    },
