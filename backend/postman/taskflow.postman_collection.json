              "const ownerId = pm.collectionVariables.get('taskflowOwnedTaskId');",
              "const resolvedId = pm.variables.replaceIn('{{taskflowCreatedTaskId}}');",
              "if (!id || ownerId !== id || resolvedId !== id) {",
              "  console.error('Run the collection create request first; task ID must match this collection run.');",
