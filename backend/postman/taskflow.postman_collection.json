    {
      "name": "Replace collection-owned task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "If-Match",
            "value": "{{taskflowTaskEtag}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"TaskFlow Postman updated sample\",\n  \"description\": \"Updated with all editable fields.\",\n  \"dueDate\": null,\n  \"priority\": \"high\",\n  \"projectId\": null,\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks/{{taskflowCreatedTaskId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.collectionVariables.get('taskflowCreatedTaskId');",
              "const ownerId = pm.collectionVariables.get('taskflowOwnedTaskId');",
              "const resolvedId = pm.variables.replaceIn('{{taskflowCreatedTaskId}}');",
              "const etag = pm.collectionVariables.get('taskflowTaskEtag');",
              "const resolvedEtag = pm.variables.replaceIn('{{taskflowTaskEtag}}');",
              "if (!id || ownerId !== id || resolvedId !== id || !/^\\\"(0|[1-9][0-9]*)\\\"$/.test(etag || '') || resolvedEtag !== etag) {",
              "  console.error('Update requires this collection run’s task and its latest strong ETag.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update replaces fields and advances version exactly once', function () {",
              "  pm.response.to.have.status(200);",
              "  const priorEtag = pm.collectionVariables.get('taskflowTaskEtag');",
              "  const priorVersion = Number(pm.collectionVariables.get('taskflowTaskVersion'));",
              "  const task = pm.response.json();",
              "  pm.expect(task.id).to.eql(pm.collectionVariables.get('taskflowCreatedTaskId'));",
              "  pm.expect(task.title).to.eql('TaskFlow Postman sample updated');",
              "  pm.expect(task.description).to.eql('Updated by this collection with the latest ETag.');",
              "  pm.expect(task.version).to.eql(priorVersion + 1);",
              "  const etag = pm.response.headers.get('ETag');",
              "  pm.expect(etag).to.eql('\\\"' + task.version + '\\\"');",
              "  pm.collectionVariables.set('taskflowPreviousEtag', priorEtag);",
              "  pm.collectionVariables.set('taskflowTaskVersion', String(task.version));",
              "  pm.collectionVariables.set('taskflowTaskEtag', etag);",
              "});"
            ]
          }
        }
      ]
    },
