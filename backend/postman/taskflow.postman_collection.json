{
  "info": {
    "_postman_id": "4e2f5ac9-356d-4851-a469-77a7104a0f10",
    "name": "TaskFlow Local API",
    "description": "Manual collection for the frozen TaskFlow contract in docs/api.md. Run only against a local disposable development service. The write requests use only the task created by this collection; path/ETag variable collisions or a non-loopback base URL skip guarded requests. Backend execution has not been verified.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const rawBaseUrl = pm.variables.replaceIn('{{baseUrl}}');",
          "let parsedBaseUrl;",
          "try {",
          "  parsedBaseUrl = new URL(rawBaseUrl);",
          "} catch (error) {",
          "  console.error('TaskFlow collection requires a valid local baseUrl.');",
          "  pm.execution.skipRequest();",
          "}",
          "if (parsedBaseUrl) {",
          "  const host = parsedBaseUrl.hostname.toLowerCase().replace(/^\\[|\\]$/g, '');",
          "  const isLoopback = host === 'localhost' || host === '127.0.0.1' || host === '::1';",
          "if (parsedBaseUrl.protocol !== 'http:' || !isLoopback || parsedBaseUrl.pathname !== '/' || parsedBaseUrl.search || parsedBaseUrl.hash || parsedBaseUrl.username || parsedBaseUrl.password) {",
          "    console.error('TaskFlow collection is restricted to an http loopback baseUrl.');",
          "    pm.execution.skipRequest();",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Create task owned by this collection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"TaskFlow Postman sample\",\n  \"description\": \"Created by this collection run; safe to update and delete through its chained requests.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of ['taskflowCreatedTaskId', 'taskflowOwnedTaskId', 'taskflowTaskVersion', 'taskflowTaskEtag', 'taskflowPreviousEtag']) {",
              "  pm.collectionVariables.set(key, '');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create returns 201 and capture only its task after validation', function () {",
              "  pm.response.to.have.status(201);",
              "  const task = pm.response.json();",
              "  pm.expect(task).to.have.property('id').that.is.a('string');",
              "  pm.expect(task).to.have.property('title', 'TaskFlow Postman sample');",
              "  pm.expect(task).to.have.property('description', 'Created by this collection run; safe to update and delete through its chained requests.');",
              "  pm.expect(task.version).to.be.a('number');",
              "  const etag = pm.response.headers.get('ETag');",
              "  const match = etag && etag.match(/^\\\"(0|[1-9][0-9]*)\\\"$/);",
              "  pm.expect(match, 'strong quoted decimal ETag').to.not.eql(null);",
              "  pm.expect(Number(match[1])).to.eql(task.version);",
              "  const baseUrl = new URL(pm.variables.replaceIn('{{baseUrl}}'));",
              "  const locationValue = pm.response.headers.get('Location');",
              "  pm.expect(locationValue, 'Location header').to.be.a('string');",
              "  const location = new URL(locationValue, baseUrl);",
              "  pm.expect(location.origin).to.eql(baseUrl.origin);",
              "  pm.expect(location.pathname).to.eql('/api/tasks/' + task.id);",
              "  pm.collectionVariables.set('taskflowCreatedTaskId', task.id);",
              "  pm.collectionVariables.set('taskflowOwnedTaskId', task.id);",
              "  pm.collectionVariables.set('taskflowTaskVersion', String(task.version));",
              "  pm.collectionVariables.set('taskflowTaskEtag', etag);",
              "  pm.collectionVariables.set('taskflowPreviousEtag', '');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List and search tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks?page={{page}}&size={{size}}&q={{q}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List returns a paginated task response', function () {",
              "  pm.response.to.have.status(200);",
              "  const result = pm.response.json();",
              "  pm.expect(result.items).to.be.an('array');",
              "  pm.expect(result.page).to.be.a('number');",
              "  pm.expect(result.size).to.be.a('number');",
              "  pm.expect(result.totalElements).to.be.a('number');",
              "  pm.expect(result.totalPages).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Read collection-owned task",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskflowCreatedTaskId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.collectionVariables.get('taskflowCreatedTaskId');",
              "const ownerId = pm.collectionVariables.get('taskflowOwnedTaskId');",
              "const resolvedId = pm.variables.replaceIn('{{taskflowCreatedTaskId}}');",
              "if (!id || ownerId !== id || resolvedId !== id) {",
              "  console.error('Run the collection create request first; task ID must match this collection run.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Read task created by this collection and refresh its version/ETag', function () {",
              "  pm.response.to.have.status(200);",
              "  const task = pm.response.json();",
              "  pm.expect(task.id).to.eql(pm.collectionVariables.get('taskflowCreatedTaskId'));",
              "  const etag = pm.response.headers.get('ETag');",
              "  const match = etag && etag.match(/^\\\"(0|[1-9][0-9]*)\\\"$/);",
              "  pm.expect(match, 'strong quoted decimal ETag').to.not.eql(null);",
              "  pm.expect(Number(match[1])).to.eql(task.version);",
              "  pm.collectionVariables.set('taskflowTaskVersion', String(task.version));",
              "  pm.collectionVariables.set('taskflowTaskEtag', etag);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Replace collection-owned task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "If-Match",
            "value": "{{taskflowTaskEtag}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"TaskFlow Postman sample updated\",\n  \"description\": \"Updated by this collection with the latest ETag.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks/{{taskflowCreatedTaskId}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.collectionVariables.get('taskflowCreatedTaskId');",
              "const ownerId = pm.collectionVariables.get('taskflowOwnedTaskId');",
              "const resolvedId = pm.variables.replaceIn('{{taskflowCreatedTaskId}}');",
              "const etag = pm.collectionVariables.get('taskflowTaskEtag');",
              "const resolvedEtag = pm.variables.replaceIn('{{taskflowTaskEtag}}');",
              "if (!id || ownerId !== id || resolvedId !== id || !/^\\\"(0|[1-9][0-9]*)\\\"$/.test(etag || '') || resolvedEtag !== etag) {",
              "  console.error('Update requires this collection run’s task and its latest strong ETag.');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update replaces fields and advances version exactly once', function () {",
              "  pm.response.to.have.status(200);",
              "  const priorEtag = pm.collectionVariables.get('taskflowTaskEtag');",
              "  const priorVersion = Number(pm.collectionVariables.get('taskflowTaskVersion'));",
              "  const task = pm.response.json();",
              "  pm.expect(task.id).to.eql(pm.collectionVariables.get('taskflowCreatedTaskId'));",
              "  pm.expect(task.title).to.eql('TaskFlow Postman sample updated');",
              "  pm.expect(task.description).to.eql('Updated by this collection with the latest ETag.');",
              "  pm.expect(task.version).to.eql(priorVersion + 1);",
              "  const etag = pm.response.headers.get('ETag');",
              "  pm.expect(etag).to.eql('\\\"' + task.version + '\\\"');",
              "  pm.collectionVariables.set('taskflowPreviousEtag', priorEtag);",
              "  pm.collectionVariables.set('taskflowTaskVersion', String(task.version));",
              "  pm.collectionVariables.set('taskflowTaskEtag', etag);",
              "});"
            ]
          }
        }
      ]
    },
